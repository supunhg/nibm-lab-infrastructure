# Homelab host firewall v6 (Claude). No global IPv6 on ens192; drop unsolicited v6 from LAN.
*filter
:INPUT ACCEPT [0:0]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:DOCKER-USER - [0:0]
-A INPUT -i lo -j ACCEPT
-A INPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A INPUT -p ipv6-icmp -j ACCEPT
-A INPUT ! -i ens192 -j ACCEPT
-A INPUT -p tcp --dport 22 -j ACCEPT
-A INPUT -p udp --dport 9993 -j ACCEPT
-A INPUT -j DROP
-A DOCKER-USER -i ens192 -m conntrack --ctstate NEW -j DROP
COMMIT
