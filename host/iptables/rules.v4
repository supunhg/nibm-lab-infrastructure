# Homelab host firewall (Claude). Docker manages its own chains at runtime - never `netfilter-persistent save` while Docker runs.
# Policy: LAN (ens192) may reach only SSH, ZeroTier, and the public service ports below.
# ZeroTier (zt+), Docker bridges and the admin workstation are trusted.
*filter
:INPUT ACCEPT [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
:HL-INPUT - [0:0]
:DOCKER-USER - [0:0]
-A INPUT -j HL-INPUT
-A HL-INPUT -i lo -j RETURN
-A HL-INPUT -m conntrack --ctstate RELATED,ESTABLISHED -j RETURN
-A HL-INPUT ! -i ens192 -j RETURN
-A HL-INPUT -p icmp -j RETURN
-A HL-INPUT -p tcp --dport 22 -j RETURN
-A HL-INPUT -p udp --dport 9993 -j RETURN
-A HL-INPUT -s 192.168.1.50/32 -j RETURN
-A HL-INPUT -j DROP
-A DOCKER-USER -m conntrack --ctstate RELATED,ESTABLISHED -j RETURN
-A DOCKER-USER ! -i ens192 -j RETURN
-A DOCKER-USER -s 192.168.1.50/32 -j RETURN
-A DOCKER-USER -p tcp -m conntrack --ctorigdstport 80 -j RETURN
-A DOCKER-USER -p tcp -m conntrack --ctorigdstport 443 -j RETURN
-A DOCKER-USER -p tcp -m conntrack --ctorigdstport 53 -j RETURN
-A DOCKER-USER -p udp -m conntrack --ctorigdstport 53 -j RETURN
-A DOCKER-USER -p tcp -m conntrack --ctorigdstport 853 -j RETURN
-A DOCKER-USER -p tcp -m conntrack --ctorigdstport 25565 -j RETURN
-A DOCKER-USER -p tcp -m conntrack --ctorigdstport 2222 -j RETURN
-A DOCKER-USER -o br+ -j DROP
-A DOCKER-USER -o docker0 -j DROP
-A DOCKER-USER -j RETURN
-A FORWARD -i zt+ -o ens192 -j ACCEPT
-A FORWARD -i ens192 -o zt+ -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A FORWARD -d 192.168.1.5/32 -p tcp -m tcp --dport 443 -j ACCEPT
COMMIT
*nat
:PREROUTING ACCEPT [0:0]
:INPUT ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
-A POSTROUTING -o ens192 -j MASQUERADE
-A POSTROUTING -d 192.168.1.5/32 -p tcp -m tcp --dport 443 -j MASQUERADE
COMMIT
